@startuml activity-core-business-flow


skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ActivityDiamondBackgroundColor #FFFFFF

' Жестко задаем порядок дорожек слева направо
|Клиент|
|Система (PWA + API)|
|Тренер|

' --- НАЧАЛО ПРОЦЕССА ---
|Тренер|
start
:Авторизация (JWT);
:Генерация сетки свободных слотов\nдля персональных занятий;

|Система (PWA + API)|
:Сохранение расписания в PostgreSQL\n(BookingsController);

|Клиент|
:Вход в личный кабинет;
:Открытие каталога тренеров;

|Система (PWA + API)|
:Выборка тренеров и доступных\nслотов из базы данных;

|Клиент|
:Выбор тренера и времени;
:Нажатие "Забронировать слот";

|Система (PWA + API)|
if (Статус абонемента?) then (Не активен)
  |Клиент|
  :Переход на страницу оплаты;
  :Оплата тарифа / разового визита;
  |Система (PWA + API)|
  :Валидация транзакции;
  :Активация доступа (MembershipService);
else (Активен)
endif

|Система (PWA + API)|
:Создание записи (BookingService);
fork
  :Списание лимита занятий;
fork again
  :Генерация ссылки Google Calendar;
end fork

|Клиент|
:Получение push-уведомления\nоб успешной записи;
:Посещение фитнес-центра (Офлайн);

|Тренер|
:Проведение тренировки;
:Отметка о завершении занятия;
:Ввод антропометрии клиента\n(вес, силовые показатели, объемы);

|Система (PWA + API)|
:Запись новых метрик в\nтаблицу Progress (EF Core);

|Клиент|
:Переход в раздел "Мой прогресс";

|Система (PWA + API)|
:Агрегация истории замеров;


|Клиент|
if (Запрос совета на основе\nновых метрик?) then (Да)
  :Отправка промпта в чат\nс AI-помощником;
  
  |Система (PWA + API)|
  if (Лимит запросов AiTrainerUsage?) then (>= 10)
    :Генерация ошибки 429\n(Too Many Requests);
    |Клиент|
    :Просмотр уведомления\nо превышении лимита;
  else (< 10)
    |Система (PWA + API)|
    :Маршрутизация запроса в\nOpenAI SDK (DeepSeek);
    :Инкремент счетчика запросов;
    :Парсинг ответа нейросети;
    
    |Клиент|
    :Получение персонального\nплана питания/тренировок;
  endif
else (Нет)
endif

|Клиент|
:Завершение работы (Logout);
stop

@enduml