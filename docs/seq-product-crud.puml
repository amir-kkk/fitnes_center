@startuml "Product CRUD — Диаграмма последовательности"

skinparam backgroundColor #FFFFFF
skinparam participant {
  BackgroundColor #E8EAF6
  BorderColor #242582
}
skinparam sequence {
  ArrowColor #242582
  LifeLineBorderColor #99738E
}

actor "Клиент" as Client
participant "Frontend" as FE
participant "Backend\n(ProductController)" as API
participant "ProductService" as PS
database "БД" as DB

== GET /api/product — Список товаров ==

Client -> FE : Открытие каталога\n(фильтры, пагинация)
FE -> API : GET /api/product?categoryId=&page=1
API -> PS : GetAllAsync(filters)
PS -> DB : SELECT Products\nJOIN Categories, Brands\nJOIN ProductImages
DB --> PS : List<Product>
PS --> API : PagedResult<ProductListItem>
API --> FE : 200 JSON (items, totalCount)
FE --> Client : Отображение списка товаров

== GET /api/product/{id} — Детали товара ==

Client -> FE : Клик на карточку товара
FE -> API : GET /api/product/5
API -> PS : GetByIdAsync(5)
PS -> DB : SELECT Product\nINCLUDE Images, Specs,\nCategory, Brand
DB --> PS : Product
PS --> API : ProductDto
API --> FE : 200 JSON
FE --> Client : Страница товара

== POST /api/product — Создание товара [Manager/Admin] ==

Client -> FE : Заполнение формы\n(название, цена, фото, хар-ки)
FE -> API : POST /api/product\n{name, price, categoryId, brandId,\nimageUrls[], specifications{}}
API -> PS : CreateAsync(dto)
PS -> DB : SELECT Category (проверка)
DB --> PS : Category
PS -> DB : SELECT Brand (проверка)
DB --> PS : Brand
PS -> DB : INSERT Product
DB --> PS : Product (id)
PS -> DB : INSERT ProductImages\n(несколько записей)
DB --> PS : ok
PS -> DB : INSERT ProductSpecifications\n(несколько записей)
DB --> PS : ok
PS --> API : ProductDto
API --> FE : 201 Created
FE --> Client : Редирект на товар

== PUT /api/product/{id} — Обновление товара [Manager/Admin] ==

Client -> FE : Редактирование формы товара
FE -> API : PUT /api/product/5\n{name, price, imageUrls[],\nspecifications{}}
API -> PS : UpdateAsync(5, dto)
PS -> DB : SELECT Product (проверка)
DB --> PS : Product
PS -> DB : SELECT Category (проверка)
DB --> PS : Category
PS -> DB : SELECT Brand (проверка)
DB --> PS : Brand
PS -> DB : DELETE старые ProductImages
DB --> PS : ok
PS -> DB : INSERT новые ProductImages
DB --> PS : ok
PS -> DB : DELETE старые ProductSpecifications
DB --> PS : ok
PS -> DB : INSERT новые ProductSpecifications
DB --> PS : ok
PS -> DB : UPDATE Product
DB --> PS : ok
PS --> API : ProductDto
API --> FE : 200 OK
FE --> Client : Обновлённая страница товара

== DELETE /api/product/{id} — Удаление товара [Manager/Admin] ==

Client -> FE : Нажатие «Удалить»
FE -> API : DELETE /api/product/5
API -> PS : DeleteAsync(5)
PS -> DB : SELECT Product
DB --> PS : Product
PS -> DB : UPDATE Product\nSET IsActive = false
DB --> PS : ok
PS --> API : void
API --> FE : 204 No Content
FE --> Client : Товар скрыт из каталога

@enduml
