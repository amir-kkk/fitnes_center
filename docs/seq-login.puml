@startuml login
title Авторизация пользователя

actor "Клиент" as C
participant "Frontend\n(React)" as F
participant "Backend\n(ASP.NET Core)" as B
database "PostgreSQL" as DB

C -> F : Вводит email и пароль
F -> B : POST /api/auth/login\n{email, password}
activate B

B -> DB : Поиск пользователя по email
DB --> B : Данные пользователя

B -> B : Верификация пароля\n(BCrypt.Verify)

B -> B : Генерация JWT-токена
' note right
'     Claims: sub, email, role
'     Алгоритм: HMAC-SHA256
'     Срок жизни: 120 мин
' end note

B --> F : 200 OK {token, user}
deactivate B

F -> F : Сохранение токена\nв localStorage
F --> C : Редирект на главную

@enduml
